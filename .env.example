# 复制成 .env.local 后填写（.env.local 不进版本库）

# 会话 cookie 的签名密钥。生产必须换成随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-change-me

# SQLite 文件位置（相对项目根目录）。换 Postgres 时改成 DATABASE_URL。
DATABASE_PATH=./data/app.db

# DeepSeek（与旧版 Streamlit 项目共用同一个 key）。不填则 JD 分析退回规则抽取。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
